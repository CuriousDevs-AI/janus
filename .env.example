# Server-only variables. Never prefix these with NEXT_PUBLIC_.
# FastAPI address reachable from the Next.js server.
JANUS_API_URL=http://localhost:8000
# Public API origin used by website forms and external webhook/API callers.
# Must match backend/JANUS_PUBLIC_API_URL.
JANUS_PUBLIC_API_URL=http://localhost:8000
# Exact browser origin (scheme + hostname + port, no trailing slash).
# Match backend/JANUS_FRONTEND_URL. Set explicitly behind a reverse proxy.
JANUS_APP_ORIGIN=http://localhost:3000
# Set true only for an explicit local demo workspace. Keep false for pilots.
NEXT_PUBLIC_JANUS_DEMO_MODE=false
