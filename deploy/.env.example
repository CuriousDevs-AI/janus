# Run python3 deploy/configure.py init once to create deploy/.env with fresh secrets.
# Hostnames only, without scheme, port, path or trailing slash.
APP_DOMAIN=
API_DOMAIN=
TLS_EMAIL=
# Voice calls: the TURN server's hostname, an A record pointing at this VPS.
TURN_DOMAIN=

# Generated once. Do not rotate these by recreating .env on an existing database.
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD
APP_DB_PASSWORD=GENERATE_APP_DB_PASSWORD
WORKER_DB_PASSWORD=GENERATE_WORKER_DB_PASSWORD
JANUS_JWT_SECRET=GENERATE_JANUS_JWT_SECRET
JANUS_ENCRYPTION_KEY=GENERATE_JANUS_ENCRYPTION_KEY
JANUS_TURN_SECRET=GENERATE_JANUS_TURN_SECRET

# Production sends real email. Enter these on the VPS, not in chat or Git.
# Single-quote passwords containing $ or # so Compose preserves them literally.
JANUS_EMAIL_FROM=
JANUS_SMTP_HOST=
JANUS_SMTP_PORT=587
JANUS_SMTP_USERNAME=
JANUS_SMTP_PASSWORD=
JANUS_SMTP_STARTTLS=true

# Select the supported version from your Meta app, for example vXX.0.
JANUS_META_GRAPH_VERSION=

# Optional: only needed for avatar uploads; WhatsApp media is not supported yet.
JANUS_S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
JANUS_S3_REGION=ap-south-1
JANUS_S3_BUCKET=
JANUS_S3_ACCESS_KEY_ID=
JANUS_S3_SECRET_ACCESS_KEY=
JANUS_S3_PUBLIC_BASE_URL=
