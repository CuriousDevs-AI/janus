JANUS_DATABASE_URL=postgresql+asyncpg://janus_app:local-app-password@localhost:55433/janus
JANUS_MIGRATION_DATABASE_URL=postgresql+asyncpg://janus:local-migration-password@localhost:55433/janus
JANUS_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
POSTGRES_PASSWORD=local-migration-password
APP_DB_PASSWORD=local-app-password
WORKER_DB_PASSWORD=local-worker-password

JANUS_ENVIRONMENT=development
JANUS_FRONTEND_URL=http://localhost:3000
JANUS_PUBLIC_API_URL=http://localhost:8000
JANUS_FORM_LIMIT_PER_MINUTE=10
JANUS_EMAIL_BACKEND=console
JANUS_EMAIL_FROM=Janus <hello@localhost>
JANUS_SMTP_HOST=localhost
JANUS_SMTP_PORT=587
JANUS_SMTP_USERNAME=
JANUS_SMTP_PASSWORD=
JANUS_SMTP_STARTTLS=true
# JANUS_S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
JANUS_S3_REGION=ap-south-1
JANUS_S3_BUCKET=
JANUS_S3_ACCESS_KEY_ID=
JANUS_S3_SECRET_ACCESS_KEY=
JANUS_S3_PUBLIC_BASE_URL=

# Generate once with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key stable and backed up; changing it makes saved secrets unreadable.
JANUS_ENCRYPTION_KEY=

# JSON list of operator-approved HTTPS API bases for openai_compatible credentials.
# Empty disables custom endpoints. Built-in providers use fixed official endpoints.
JANUS_AI_ALLOWED_BASE_URLS=[]

# Set to the supported Graph API version selected in your Meta app (vXX.0).
# Required on both API and worker when using WhatsApp; no default is guessed.
JANUS_META_GRAPH_VERSION=
